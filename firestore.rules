rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'luuh90902017@gmail.com'
      );
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() > 1 &&
             data.email is string && data.email.size() > 3 &&
             data.message is string && data.message.size() > 5;
    }

    // Public readable institutional content & Admin writeable
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages_seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services_products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages (Leads)
    match /messages/{docId} {
      allow create: if isValidContactMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
